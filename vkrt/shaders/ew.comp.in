// 要素演算テンプレート（tools/gen_shaders.py が -D 付きで展開する）。ストライド・ブロードキャスト対応、最大 5 次元。
// 入力 a, b, c と出力 out の dtype は KIND 値（0=f32, 1=bf16, 2=f16, 3=u8/bool）で指定し、計算は常に fp32。
// サブグループ演算は使わない（サブグループサイズは 32/64 で可変。IREE で決め打ちが誤結果を生んだ教訓）。
#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require

layout(buffer_reference, scalar, buffer_reference_align = 4) buffer RF32 { float v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 2) buffer RBF16 { uint16_t v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 2) buffer RF16 { uint16_t v[]; };
// fp16 は 16 ビット整数で保存し、変換は GLSL 標準の pack/unpackHalf2x16 で行う（shaderFloat16 機能が不要。
// RX 550(Polaris)・GTX 1060(Pascal) は shaderFloat16 を持たない）。
float h2f(uint16_t h) { return unpackHalf2x16(uint(h)).x; }
// f32 -> f16 は最近接偶数丸め(RTE)を自前で行う。packHalf2x16 は丸めが実装依存で、AMD(RADV/Windows 版とも)では
// 切り捨て(RTZ)になり CPU と 1 ulp ずれる（実測: ランダム入力の約半数がビット不一致）。
uint16_t f2h(float f) {
    uint u = floatBitsToUint(f);
    uint sign = (u >> 16) & 0x8000u;
    uint e = (u >> 23) & 0xFFu;
    uint m = u & 0x7FFFFFu;
    if (e == 0xFFu) return uint16_t(sign | 0x7C00u | (m != 0u ? (0x200u | (m >> 13)) : 0u));  // inf / NaN
    int ne = int(e) - 127 + 15;
    if (ne >= 31) return uint16_t(sign | 0x7C00u);  // オーバーフロー -> inf
    if (ne <= 0) {                                   // 非正規化数 or 0
        if (ne < -10) return uint16_t(sign);
        m |= 0x800000u;
        uint shift = uint(14 - ne);
        uint hm = m >> shift;
        uint rem = m & ((1u << shift) - 1u);
        uint halfway = 1u << (shift - 1u);
        if (rem > halfway || (rem == halfway && (hm & 1u) != 0u)) hm++;
        return uint16_t(sign | hm);
    }
    uint hm = m >> 13;
    uint rem = m & 0x1FFFu;
    uint h = sign | (uint(ne) << 10) | hm;
    if (rem > 0x1000u || (rem == 0x1000u && (hm & 1u) != 0u)) h++;  // 繰り上がりは指数部へ伝播してよい
    return uint16_t(h);
}

layout(buffer_reference, scalar, buffer_reference_align = 1) buffer RU8 { uint8_t v[]; };

layout(push_constant, scalar) uniform P {
    uint64_t out_;
    uint64_t a;
    uint64_t b;
    uint64_t c;
    uint n;
    uint pad;
    uint sz[4];
    uint so[4];
    uint sa[4];
    uint sb[4];
    uint sc[4];
    float s0;
    float s1;
} p;  // 合計 128 バイト（maxPushConstantsSize の Vulkan 保証最小値。Windows の AMD ドライバは 128 を報告する）

layout(local_size_x = 256) in;

float bf2f(uint16_t v) { return uintBitsToFloat(uint(v) << 16); }
uint16_t f2bf(float x) {
    if (isnan(x)) return uint16_t(0x7FC0u);
    uint u = floatBitsToUint(x);
    u += 0x7FFFu + ((u >> 16) & 1u);  // 最近接偶数丸め
    return uint16_t(u >> 16);
}

#if A_KIND == 0
float ldA(uint i) { return RF32(p.a).v[i]; }
#elif A_KIND == 1
float ldA(uint i) { return bf2f(RBF16(p.a).v[i]); }
#elif A_KIND == 2
float ldA(uint i) { return h2f(RF16(p.a).v[i]); }
#elif A_KIND == 3
float ldA(uint i) { return float(RU8(p.a).v[i]); }
#endif

#if B_KIND == 0
float ldB(uint i) { return RF32(p.b).v[i]; }
#elif B_KIND == 1
float ldB(uint i) { return bf2f(RBF16(p.b).v[i]); }
#elif B_KIND == 2
float ldB(uint i) { return h2f(RF16(p.b).v[i]); }
#elif B_KIND == 3
float ldB(uint i) { return float(RU8(p.b).v[i]); }
#endif

#if C_KIND == 0
float ldC(uint i) { return RF32(p.c).v[i]; }
#elif C_KIND == 1
float ldC(uint i) { return bf2f(RBF16(p.c).v[i]); }
#elif C_KIND == 2
float ldC(uint i) { return h2f(RF16(p.c).v[i]); }
#elif C_KIND == 3
float ldC(uint i) { return float(RU8(p.c).v[i]); }
#endif

#if O_KIND == 0
void stO(uint i, float x) { RF32(p.out_).v[i] = x; }
#elif O_KIND == 1
void stO(uint i, float x) { RBF16(p.out_).v[i] = f2bf(x); }
#elif O_KIND == 2
void stO(uint i, float x) { RF16(p.out_).v[i] = f2h(x); }
#elif O_KIND == 3
void stO(uint i, float x) { RU8(p.out_).v[i] = uint8_t(x != 0.0 ? 1u : 0u); }
#endif

const float PI = 3.14159265358979323846;

// erf: Abramowitz-Stegun より高精度な有理近似（W. J. Cody 方式の fp32 向け簡易版: 相対誤差 ~1e-7）
float erf_f(float x) {
    float ax = abs(x);
    // Numerical Recipes の erfc Chebyshev 近似（|相対誤差| < 1.2e-7）
    float t = 1.0 / (1.0 + 0.5 * ax);
    float poly = -ax * ax - 1.26551223 + t * (1.00002368 + t * (0.37409196 + t * (0.09678418 +
                 t * (-0.18628806 + t * (0.27886807 + t * (-1.13520398 + t * (1.48851587 +
                 t * (-0.82215223 + t * 0.17087277))))))));
    float erfc_v = t * exp(poly);
    float r = 1.0 - erfc_v;
    return x >= 0.0 ? r : -r;
}

float tanh_f(float v) {
    float t = exp(-2.0 * abs(v));
    float r = (1.0 - t) / (1.0 + t);
    return v >= 0.0 ? r : -r;
}

// 引数を [-pi, pi] へ縮約してから sin/cos（GLSL の sin/cos は大きい引数で精度が保証されない）
float reduce_pi(float x) {
    float k = round(x * (1.0 / (2.0 * PI)));
    // Cody-Waite: 2*pi を上位/下位に分けて引く
    float r = x - k * 6.28125;
    r = r - k * 0.0019353071795864769;
    return r;
}
float sin_f(float x) { return sin(reduce_pi(x)); }
float cos_f(float x) { return cos(reduce_pi(x)); }

float pow_f(float x, float e) {
    if (e == 2.0) return x * x;
    if (e == 1.0) return x;
    if (e == 0.0) return 1.0;
    if (e == 0.5) return sqrt(x);
    if (e == -1.0) return 1.0 / x;
    float ei = round(e);
    if (ei == e) {
        float r = pow(abs(x), e);
        bool odd = mod(abs(ei), 2.0) == 1.0;
        return (x < 0.0 && odd) ? -r : r;
    }
    return pow(x, e);
}

float sigmoid_f(float x) { return 1.0 / (1.0 + exp(-x)); }

// silu_backward: g * sig * (1 + x * (1 - sig))
float silu_bwd(float g, float x) {
    float s = sigmoid_f(x);
    return g * s * (1.0 + x * (1.0 - s));
}

// gelu_backward (approximate='none')
float gelu_erf_bwd(float g, float x) {
    const float kAlpha = 0.70710678118654752440;      // 1/sqrt(2)
    const float kBeta = 0.39894228040143267794;       // 1/sqrt(2*pi)
    float cdf = 0.5 * (1.0 + erf_f(x * kAlpha));
    float pdf = kBeta * exp(-0.5 * x * x);
    return g * (cdf + x * pdf);
}

// gelu_backward (approximate='tanh')
float gelu_tanh_bwd(float g, float x) {
    const float kBeta = 0.79788456080286535588;       // sqrt(2/pi)
    const float kKappa = 0.044715;
    float x_sq = x * x;
    float x_cube = x_sq * x;
    float inner = kBeta * (x + kKappa * x_cube);
    float t = tanh_f(inner);
    float left = 0.5 * x;
    float right = 1.0 + t;
    float left_derivative = 0.5 * right;
    float right_derivative = left * (1.0 - t * t) * kBeta * (1.0 + 3.0 * kKappa * x_sq);
    return g * (left_derivative + right_derivative);
}

#ifdef FAST1D
// 次元結合後に 1 次元になった場合の高速経路（連続メモリの 2 項演算など、学習で最も多い形）。
// 一般経路は 1 要素ごとに 4 次元分の整数除算・剰余をするため、除算の遅い GPU(Polaris など)で ALU 律速になり、
// メモリ帯域のピークの 1 割程度しか使えなかった（RX 550 で実測 12GB/s / 112GB/s）。
// ここでは除算を使わず、1 スレッドが 4 要素を（スレッド間でコアレスするよう間隔を空けて）処理して ILP を稼ぐ。
void main() {
    const uint total = gl_NumWorkGroups.x * 256u;
    const uint base = gl_GlobalInvocationID.x;
    const float S0 = p.s0;
    const float S1 = p.s1;
    float xs[4];
    float ys[4];
    float zs[4];
    for (uint k = 0u; k < 4u; ++k) {
        uint i = base + k * total;
        xs[k] = 0.0; ys[k] = 0.0; zs[k] = 0.0;
        if (i < p.n) {
#ifdef HAS_A
            xs[k] = ldA(i * p.sa[3]);
#endif
#ifdef HAS_B
            ys[k] = ldB(i * p.sb[3]);
#endif
#ifdef HAS_C
            zs[k] = ldC(i * p.sc[3]);
#endif
        }
    }
    for (uint k = 0u; k < 4u; ++k) {
        uint i = base + k * total;
        if (i < p.n) {
            float x = xs[k];
            float y = ys[k];
            float z = zs[k];
            float r = OP_EXPR;
            stO(i * p.so[3], r);
        }
    }
}
#else
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    uint rem = i;
    uint oo = 0u, oa = 0u, ob = 0u, oc = 0u;
    for (int d = 3; d >= 0; --d) {
        uint idx = rem % p.sz[d];
        rem /= p.sz[d];
        oo += idx * p.so[d];
        oa += idx * p.sa[d];
        ob += idx * p.sb[d];
        oc += idx * p.sc[d];
    }
    float S0 = p.s0;
    float S1 = p.s1;
#ifdef HAS_A
    float x = ldA(oa);
#endif
#ifdef HAS_B
    float y = ldB(ob);
#endif
#ifdef HAS_C
    float z = ldC(oc);
#endif
    float r = OP_EXPR;
    stO(oo, r);
}
#endif
