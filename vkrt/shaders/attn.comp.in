// 融合アテンション（flash attention 型。logits を fp32 のまま保持し、N x N の行列をメモリに作らない）。
// KIND: q/k/v/dO/出力の dtype（計算は常に fp32）。D <= 128。マスク・dropout・causal 無し。
// MODE 0: forward。out[b,q,h,:] = softmax(scale * Q K^T) V、lse[b,h,q] = logsumexp（fp32）。
// MODE 1: backward の dK / dV（1 ワークグループが 1 つのキーブロック 32 行を担当し、全クエリブロックを回る）。
// MODE 2: backward の dQ（1 ワークグループが 1 つのクエリブロック 32 行を担当し、全キーブロックを回る）。
// MODE 3: delta[b,h,q] = sum_d out * dO（fp32）。
// 入力 q / k / v / dO は (batch, head, seq) のストライドを指定でき、d 方向は連続。k と v はストライドを共有する。
// 出力（out / dq / dk / dv）は [B, S, H, D] の連続メモリ（PyTorch 標準の SDPA と同じく、[B,H,S,D] に permute して返す）。
// タイル: 32 x 32、D を 32 ごとのチャンクで共有メモリへ。256 スレッド。共有メモリは約 25KB（上限 32KB 以内）。
// 内積 (S = Q K^T 等): 256 スレッドを「4 つの d スライス x 64 個の 4x4 タイル」に分け、各スレッドは 4x4 の部分和を
//   レジスタに持つ（共有メモリ読み出し 8 回で FMA 16 回）。最後に 4 スライスの部分和を共有メモリ経由で足し、
//   各スレッドが S タイルの 1 行 x 4 列を受け取る。
// 積和 (O += P V 等): 各スレッドが 4 行 x 4 列（D のうち 4 列）を担当する（共有メモリ読み出し 8 回で FMA 16 回）。
//   列グループ数は ceil(D/4)。使うスレッドは 8 * ceil(D/4) 個（D が小さいと残りは遊ぶ）。
#version 450
#extension GL_GOOGLE_include_directive : require
#include "types.glsl"

layout(push_constant, scalar) uniform P {
    uint64_t a0;  // q（MODE 3: out）
    uint64_t a1;  // k
    uint64_t a2;  // v
    uint64_t a3;  // MODE0: out / MODE1,2,3: dO
    uint64_t a4;  // lse
    uint64_t a5;  // delta
    uint64_t a6;  // MODE1: dk / MODE2: dq
    uint64_t a7;  // MODE1: dv
    uint qsb, qsh, qss;
    uint ksb, ksh, kss;  // k と v 共通
    uint dsb, dsh, dss;  // dO（MODE 3 でも dO）
    uint B, H, Sq, Sk, D;
    float scale;
    uint pad;
} p;  // 合計 128 バイト

layout(local_size_x = 256) in;

const float NEG = -3.0e38;

// 4 要素ベクトルの読み込み（ポインタが 16 バイト、オフセットとストライドが 4 要素に揃っているとき）。
#if KIND == 0
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer RV4 { vec4 v; };
vec4 ldv4(uint64_t base, uint i) { return RV4(base + uint64_t(i) * 4ul).v; }
#else
layout(buffer_reference, scalar, buffer_reference_align = 8) buffer RV4 { u16vec4 v; };
#if KIND == 1
#define CV16(x) bf2f(x)
#else
#define CV16(x) h2f(x)
#endif
vec4 ldv4(uint64_t base, uint i) {
    u16vec4 w = RV4(base + uint64_t(i) * 2ul).v;
    return vec4(CV16(w.x), CV16(w.y), CV16(w.z), CV16(w.w));
}
#endif
bool g_al;  // 全ポインタとストライドがベクトル読み込みに揃っているか

// 行 row の列 d..d+3（範囲外は 0）。
vec4 ld4(uint64_t base, uint off, uint ss, uint row, uint nrows, uint d) {
    if (row >= nrows || d >= p.D) return vec4(0.0);
    uint i = off + row * ss + d;
    if (g_al && d + 4u <= p.D) return ldv4(base, i);
    vec4 r = vec4(0.0);
    for (uint k = 0u; k < 4u; ++k) {
        if (d + k < p.D) r[k] = ldK(base, i + k);
    }
    return r;
}

#if MODE == 3
shared float DP[4352];  // 256 行 x 17（部分和 16 + パディング 1）
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer RVF4 { vec4 v; };
// fp32 の 4 要素（D を超える分は 0）
vec4 ldF4(uint64_t base, uint oo, uint d) {
    uint i = oo + d;
    if (g_al) return RVF4(base + uint64_t(i) * 4ul).v;
    vec4 r = vec4(0.0);
    for (uint k = 0u; k < 4u; ++k) {
        if (d + k < p.D) r[k] = ldF(base, i + k);
    }
    return r;
}
#endif
#if MODE != 3
shared float R[4096];  // チャンクバッファ(TA / TB)、32 行 x 128 列のブロック(V / dO / Q / K)、部分和の合算で兼用
#define TA_BASE 0u
#define TB_BASE 1056u
#if MODE != 0
shared float DSs[1056];
#endif
#if MODE <= 1
shared float Ps[1056];  // MODE 0: 生のロジット / MODE 1: P
#endif
#if MODE == 0
shared float Pe[1056];  // exp(ロジット - 行の最大)
shared float Al[32];    // 行ごとの alpha（最後は行ごとの m）
#endif

// このスレッドが担当するチャンクの 4 要素（tile_dot の先頭チャンクを先読みするために呼び出し側が使う）。
vec4 tile_ld(uint64_t base, uint off, uint ss, uint row0, uint nrows) {
    uint t = gl_LocalInvocationID.x;
    return ld4(base, off, ss, row0 + (t >> 3u), nrows, (t & 7u) * 4u);
}

// S タイル (32 x 32) = A[行] . B[行]。na / nb は tile_ld で先に読んだ先頭チャンク（d = 0..31）。戻り値は、このスレッドの 1 行 x 4 列:
//   行 = (u >> 3) * 4 + s、列 = (u & 7) * 4 + {0..3}（u = t & 63、s = t >> 6）。
// A の行は ar0 から、B の行は br0 から（各 32 行、範囲外は 0）。
vec4 tile_dot(uint64_t ab, uint ao, uint as_, uint ar0, uint anr, uint64_t bb, uint bo, uint bs, uint br0, uint bnr,
              vec4 na, vec4 nb) {
    uint t = gl_LocalInvocationID.x;
    uint u = t & 63u;
    uint s = t >> 6u;
    uint ra = (u >> 3u) * 4u * 33u;
    uint rb = (u & 7u) * 4u * 33u;
    float c[16];
    for (uint e = 0u; e < 16u; ++e) c[e] = 0.0;
    uint lr = t >> 3u;
    uint lc = (t & 7u) * 4u;
    for (uint d0 = 0u; d0 < p.D; d0 += 32u) {
        barrier();
        for (uint k = 0u; k < 4u; ++k) {
            R[TA_BASE + lr * 33u + lc + k] = na[k];
            R[TB_BASE + lr * 33u + lc + k] = nb[k];
        }
        barrier();
        if (d0 + 32u < p.D) {  // 次のチャンクを先に発行（計算と重ねる）
            na = ld4(ab, ao, as_, ar0 + lr, anr, d0 + 32u + lc);
            nb = ld4(bb, bo, bs, br0 + lr, bnr, d0 + 32u + lc);
        }
        for (uint k = 0u; k < 8u; ++k) {
            uint d = k * 4u + s;
            if (d0 + d >= p.D) break;
            float a0 = R[TA_BASE + ra + d];
            float a1 = R[TA_BASE + ra + 33u + d];
            float a2 = R[TA_BASE + ra + 66u + d];
            float a3 = R[TA_BASE + ra + 99u + d];
            float b0 = R[TB_BASE + rb + d];
            float b1 = R[TB_BASE + rb + 33u + d];
            float b2 = R[TB_BASE + rb + 66u + d];
            float b3 = R[TB_BASE + rb + 99u + d];
            c[0] += a0 * b0;  c[1] += a0 * b1;  c[2] += a0 * b2;  c[3] += a0 * b3;
            c[4] += a1 * b0;  c[5] += a1 * b1;  c[6] += a1 * b2;  c[7] += a1 * b3;
            c[8] += a2 * b0;  c[9] += a2 * b1;  c[10] += a2 * b2; c[11] += a2 * b3;
            c[12] += a3 * b0; c[13] += a3 * b1; c[14] += a3 * b2; c[15] += a3 * b3;
        }
    }
    barrier();
    for (uint e = 0u; e < 16u; ++e) R[e * 256u + s * 64u + u] = c[e];
    barrier();
    vec4 r;
    for (uint j = 0u; j < 4u; ++j) {
        uint o = (s * 4u + j) * 256u + u;
        r[j] = R[o] + R[o + 64u] + R[o + 128u] + R[o + 192u];
    }
    barrier();  // 呼び出し側が R を再利用してよい
    return r;
}

// 32 行 x 128 列のブロックを、各スレッド 4 個のベクトル（e4 = t + i*256 → 行 e4/32、列 (e4%32)*4）として読む。
// D を超える列と範囲外の行は 0。書き込みは blk_store（先読みして計算と重ねるため、読みと書きを分ける）。
void blk_load(out vec4 r[4], uint64_t base, uint off, uint ss, uint row0, uint nrows) {
    uint t = gl_LocalInvocationID.x;
    for (uint i = 0u; i < 4u; ++i) {
        uint e4 = t + i * 256u;
        r[i] = ld4(base, off, ss, row0 + (e4 >> 5u), nrows, (e4 & 31u) * 4u);
    }
}

void blk_store(vec4 r[4]) {
    uint t = gl_LocalInvocationID.x;
    for (uint i = 0u; i < 4u; ++i) {
        uint e4 = t + i * 256u;
        uint o = (e4 >> 5u) * 128u + (e4 & 31u) * 4u;
        for (uint k = 0u; k < 4u; ++k) R[o + k] = r[i][k];
    }
}

// ブロック R の (行 row, 列グループ g) の 4 要素（列 g*4 .. g*4+3）。
vec4 r4(uint row, uint g) {
    uint o = row * 128u + g * 4u;
    return vec4(R[o], R[o + 1u], R[o + 2u], R[o + 3u]);
}

// 書き込み先（[B, S, H, D] 連続）へ、1 行 x 4 列（列グループ g）のうち D 内のものを書く。
void store_row4(uint64_t base, uint b, uint h, uint S, uint row, uint g, vec4 v, float mul) {
    if (row >= S) return;
    uint o = ((b * S + row) * p.H + h) * p.D;
    for (uint k = 0u; k < 4u; ++k) {
        uint d = g * 4u + k;
        if (d < p.D) stK(base, o + d, v[k] * mul);
    }
}

// fp32 の出力（delta 用）。base は fp32 の [B, S, H, D] 連続メモリ。
void store_row4_32(uint64_t base, uint b, uint h, uint S, uint row, uint g, vec4 v, float mul) {
    if (row >= S) return;
    uint o = ((b * S + row) * p.H + h) * p.D;
    for (uint k = 0u; k < 4u; ++k) {
        uint d = g * 4u + k;
        if (d < p.D) stF(base, o + d, v[k] * mul);
    }
}
#endif

void main() {
    uint t = gl_LocalInvocationID.x;
    uint bh = gl_WorkGroupID.y;
    uint b = bh / p.H;
    uint h = bh % p.H;
#if MODE == 3
    // 1 ワークグループ = 連続する 256 行。16 スレッドで 1 行（d を 4 要素ずつ飛ばし）を 16 回回し、部分和を LDS で足す。
    g_al = (uint((p.a0 | p.a3) & 15ul) == 0u) && ((p.dsb | p.dsh | p.dss) & 3u) == 0u && (p.D & 3u) == 0u;
    uint lane = t & 15u;
    uint rl = t >> 4u;
    for (uint step = 0u; step < 16u; ++step) {
        uint idx = gl_WorkGroupID.x * 256u + step * 16u + rl;
        float part = 0.0;
        if (idx < p.B * p.H * p.Sq) {
            uint q = idx % p.Sq;
            uint bhh = idx / p.Sq;
            uint bb = bhh / p.H;
            uint hh = bhh % p.H;
            uint oo = ((bb * p.Sq + q) * p.H + hh) * p.D;
            uint dd = bb * p.dsb + hh * p.dsh + q * p.dss;
            for (uint d = lane * 4u; d < p.D; d += 64u) {
                // pad != 0 のとき out は fp32（丸め前の O。delta を逆伝播の P と整合させるため）
                vec4 o4 = (p.pad != 0u) ? ldF4(p.a0, oo, d) : ld4(p.a0, oo, 0u, 0u, 1u, d);
                vec4 g4 = ld4(p.a3, dd, 0u, 0u, 1u, d);
                part += dot(o4, g4);
            }
        }
        DP[(step * 16u + rl) * 17u + lane] = part;
    }
    barrier();
    uint idx = gl_WorkGroupID.x * 256u + t;
    if (idx < p.B * p.H * p.Sq) {
        float sum = 0.0;
        for (uint l = 0u; l < 16u; ++l) sum += DP[t * 17u + l];
        stF(p.a5, idx, sum);
    }
#else
    g_al = (uint((p.a0 | p.a1 | p.a2 | p.a3) & 15ul) == 0u) &&
           (((p.qsb | p.qsh | p.qss | p.ksb | p.ksh | p.kss | p.dsb | p.dsh | p.dss) & 3u) == 0u);
    uint qoff = b * p.qsb + h * p.qsh;
    uint koff = b * p.ksb + h * p.ksh;
    uint doff = b * p.dsb + h * p.dsh;
    uint u = t & 63u;
    uint srow = (u >> 3u) * 4u + (t >> 6u);  // tile_dot の結果の行
    uint scol = (u & 7u) * 4u;                // 同、列の先頭
    uint c4 = (p.D + 3u) >> 2u;               // 列グループ数
    uint pr = t / c4;                         // 積和でのこのスレッドの行グループ（行 pr*4 .. pr*4+3）
    uint gc = t - pr * c4;                    // 同、列グループ
    bool pact = pr < 8u;
    vec4 acc[4] = vec4[4](vec4(0.0), vec4(0.0), vec4(0.0), vec4(0.0));

#if MODE == 0
    uint qb0 = gl_WorkGroupID.x * 32u;
    uint rr = t >> 3u;   // softmax でのこのスレッドの行（8 スレッドで 1 行）
    uint l8 = t & 7u;
    float m = NEG;
    vec4 lsum = vec4(0.0);
    vec4 qc0 = tile_ld(p.a0, qoff, p.qss, qb0, p.Sq);  // Q の先頭チャンク（全反復で共通）
    vec4 kc0 = tile_ld(p.a1, koff, p.kss, 0u, p.Sk);
    vec4 vb[4];
    blk_load(vb, p.a2, koff, p.kss, 0u, p.Sk);
    for (uint kb0 = 0u; kb0 < p.Sk; kb0 += 32u) {
        vec4 s = tile_dot(p.a0, qoff, p.qss, qb0, p.Sq, p.a1, koff, p.kss, kb0, p.Sk, qc0, kc0);
        for (uint k = 0u; k < 4u; ++k) Ps[srow * 33u + scol + k] = (kb0 + scol + k < p.Sk) ? s[k] * p.scale : NEG;
        blk_store(vb);
        barrier();
        float mrow = NEG;
        for (uint j = 0u; j < 32u; ++j) mrow = max(mrow, Ps[rr * 33u + j]);
        float mn = max(m, mrow);
        float alpha = exp(m - mn);
        for (uint k = 0u; k < 4u; ++k) {
            float sv = Ps[rr * 33u + l8 * 4u + k];
            Pe[rr * 33u + l8 * 4u + k] = (sv <= -1.0e38) ? 0.0 : exp(sv - mn);
        }
        if (l8 == 0u) Al[rr] = alpha;
        m = mn;
        barrier();
        // 次の反復の K / V を先に発行（PV の計算と重ねる）
        kc0 = tile_ld(p.a1, koff, p.kss, kb0 + 32u, p.Sk);
        blk_load(vb, p.a2, koff, p.kss, kb0 + 32u, p.Sk);
        if (pact) {
            for (uint i = 0u; i < 4u; ++i) {
                float a = Al[pr * 4u + i];
                acc[i] *= a;
                lsum[i] *= a;
            }
            for (uint j = 0u; j < 32u; ++j) {
                vec4 vb = r4(j, gc);
                for (uint i = 0u; i < 4u; ++i) {
                    float pj = Pe[(pr * 4u + i) * 33u + j];
                    acc[i] += pj * vb;
                    lsum[i] += pj;
                }
            }
        }
    }
    barrier();
    if (l8 == 0u) Al[rr] = m;
    barrier();
    if (pact) {
        for (uint i = 0u; i < 4u; ++i) {
            uint q = qb0 + pr * 4u + i;
            float l = lsum[i];
            float inv = l > 0.0 ? 1.0 / l : 0.0;
            store_row4(p.a3, b, h, p.Sq, q, gc, acc[i], inv);
            if (p.a5 != 0ul) store_row4_32(p.a5, b, h, p.Sq, q, gc, acc[i], inv);  // fp32 の O（delta 用）
            if (gc == 0u && q < p.Sq) stF(p.a4, bh * p.Sq + q, l > 0.0 ? Al[pr * 4u + i] + log(l) : NEG);
        }
    }

#elif MODE == 1
    uint kb0 = gl_WorkGroupID.x * 32u;
    vec4 dv[4] = vec4[4](vec4(0.0), vec4(0.0), vec4(0.0), vec4(0.0));
    vec4 kc0 = tile_ld(p.a1, koff, p.kss, kb0, p.Sk);  // K / V の先頭チャンク（全反復で共通）
    vec4 vc0 = tile_ld(p.a2, koff, p.kss, kb0, p.Sk);
    for (uint qb0 = 0u; qb0 < p.Sq; qb0 += 32u) {
        vec4 qc0 = tile_ld(p.a0, qoff, p.qss, qb0, p.Sq);
        vec4 dc0 = tile_ld(p.a3, doff, p.dss, qb0, p.Sq);
        vec4 dob[4];
        blk_load(dob, p.a3, doff, p.dss, qb0, p.Sq);
        vec4 s = tile_dot(p.a0, qoff, p.qss, qb0, p.Sq, p.a1, koff, p.kss, kb0, p.Sk, qc0, kc0);
        vec4 dp = tile_dot(p.a3, doff, p.dss, qb0, p.Sq, p.a2, koff, p.kss, kb0, p.Sk, dc0, vc0);
        uint qa = qb0 + srow;
        bool qv = qa < p.Sq;
        float lse = qv ? ldF(p.a4, bh * p.Sq + qa) : 0.0;
        float de = qv ? ldF(p.a5, bh * p.Sq + qa) : 0.0;
        for (uint k = 0u; k < 4u; ++k) {
            float pp = (qv && kb0 + scol + k < p.Sk) ? exp(s[k] * p.scale - lse) : 0.0;
            Ps[srow * 33u + scol + k] = pp;
            DSs[srow * 33u + scol + k] = pp * (dp[k] - de);
        }
        blk_store(dob);
        barrier();
        vec4 qb[4];
        blk_load(qb, p.a0, qoff, p.qss, qb0, p.Sq);
        if (pact) {
            for (uint q = 0u; q < 32u; ++q) {
                vec4 bq = r4(q, gc);
                for (uint i = 0u; i < 4u; ++i) dv[i] += Ps[q * 33u + pr * 4u + i] * bq;
            }
        }
        barrier();
        blk_store(qb);
        barrier();
        if (pact) {
            for (uint q = 0u; q < 32u; ++q) {
                vec4 bq = r4(q, gc);
                for (uint i = 0u; i < 4u; ++i) acc[i] += DSs[q * 33u + pr * 4u + i] * bq;
            }
        }
    }
    if (pact) {
        for (uint i = 0u; i < 4u; ++i) {
            uint key = kb0 + pr * 4u + i;
            store_row4(p.a6, b, h, p.Sk, key, gc, acc[i], p.scale);
            store_row4(p.a7, b, h, p.Sk, key, gc, dv[i], 1.0);
        }
    }

#elif MODE == 2
    uint qb0 = gl_WorkGroupID.x * 32u;
    vec4 qc0 = tile_ld(p.a0, qoff, p.qss, qb0, p.Sq);  // Q / dO の先頭チャンク（全反復で共通）
    vec4 dc0 = tile_ld(p.a3, doff, p.dss, qb0, p.Sq);
    for (uint kb0 = 0u; kb0 < p.Sk; kb0 += 32u) {
        vec4 kc0 = tile_ld(p.a1, koff, p.kss, kb0, p.Sk);
        vec4 vc0 = tile_ld(p.a2, koff, p.kss, kb0, p.Sk);
        vec4 kbk[4];
        blk_load(kbk, p.a1, koff, p.kss, kb0, p.Sk);
        vec4 s = tile_dot(p.a0, qoff, p.qss, qb0, p.Sq, p.a1, koff, p.kss, kb0, p.Sk, qc0, kc0);
        vec4 dp = tile_dot(p.a3, doff, p.dss, qb0, p.Sq, p.a2, koff, p.kss, kb0, p.Sk, dc0, vc0);
        uint qa = qb0 + srow;
        bool qv = qa < p.Sq;
        float lse = qv ? ldF(p.a4, bh * p.Sq + qa) : 0.0;
        float de = qv ? ldF(p.a5, bh * p.Sq + qa) : 0.0;
        for (uint k = 0u; k < 4u; ++k) {
            float pp = (qv && kb0 + scol + k < p.Sk) ? exp(s[k] * p.scale - lse) : 0.0;
            DSs[srow * 33u + scol + k] = pp * (dp[k] - de);
        }
        blk_store(kbk);
        barrier();
        if (pact) {
            for (uint k = 0u; k < 32u; ++k) {
                vec4 bk = r4(k, gc);
                for (uint i = 0u; i < 4u; ++i) acc[i] += DSs[(pr * 4u + i) * 33u + k] * bk;
            }
        }
    }
    if (pact) {
        for (uint i = 0u; i < 4u; ++i) store_row4(p.a6, b, h, p.Sq, qb0 + pr * 4u + i, gc, acc[i], p.scale);
    }
#endif
#endif
}
